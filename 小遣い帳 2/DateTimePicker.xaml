<Window x:Class="DateTimePicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:小遣い帳_2"
        mc:Ignorable="d"
        Title="日付と時刻を入力" Height="100" Width="360" Loaded="Window_Loaded" FontFamily="BIZ UDPGothic" FontSize="16">
    <Window.Resources>
        <local:SuperDateTimePicked x:Key="SuperDateTimeSet"/>
        <Style TargetType="TextBlock">
            <Setter Property="Text" Value=":"/>
            <Setter Property="Margin" Value="5,0,5,0"/>
        </Style>
    </Window.Resources>
    <DockPanel DataContext="{StaticResource SuperDateTimeSet}" LastChildFill="False">
        <TextBlock Text="日付と時刻を設定します．" TextWrapping="Wrap" DockPanel.Dock="Top" VerticalAlignment="Top"/>
        <Button DockPanel.Dock="Bottom" x:Name="SuperExit">確定</Button>
        <DatePicker DockPanel.Dock="Left" Text="{Binding Path=Date, Mode=TwoWay, StringFormat=d, ConverterCulture=ja-JP, UpdateSourceTrigger=PropertyChanged}" Width="Auto" VerticalAlignment="Top"/>
        <TextBox DockPanel.Dock="Left" Text="{Binding Path=Hour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top"/>
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Top"/>
        <TextBox DockPanel.Dock="Left" Text="{Binding Path=Minute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top"/>
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Top"/>
        <TextBox Text="{Binding Path=Second, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DockPanel.Dock="Left" VerticalAlignment="Top"/>
    </DockPanel>
</Window>
